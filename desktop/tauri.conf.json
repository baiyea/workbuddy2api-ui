{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wb2api-desktop",
  "version": "0.1.0",
  "identifier": "com.workbuddy2api.desktop",
  "build": { "frontendDist": "ui" },
  "app": { "windows": [], "security": { "csp": "default-src 'none'" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "resources/runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" }, "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] } }
  }
}
