+package claudemessages
+
+import (
+	"context"
+	"testing"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/relaykit/relayconvert/convmeta"
+	"github.com/stretchr/testify/require"
+)
+
+func TestClaudePlaintextMixedHistory(t *testing.T) {
+	for _, withTool := range []bool{false, true} {
+		t.Run(map[bool]string{false: "thinking-only", true: "text-tool-result"}[withTool], func(t *testing.T) {
+			thought, text := "think carefully", "checking"
+			blocks := []dto.ClaudeMediaMessage{{Type: "thinking", Thinking: &thought}}
+			if withTool {
+				blocks = append(blocks, dto.ClaudeMediaMessage{Type: "text", Text: &text}, dto.ClaudeMediaMessage{Type: "tool_use", Id: "call_a", Name: "check", Input: map[string]any{"q": "hi"}})
+			}
+			messages := []dto.ClaudeMessage{{Role: "assistant", Content: blocks}}
+			if withTool {
+				messages = append(messages, dto.ClaudeMessage{Role: "user", Content: []dto.ClaudeMediaMessage{{Type: "tool_result", ToolUseId: "call_a", Content: "checked"}}})
+			}
+			got, err := ClaudeMessagesRequestToOpenAIChat(context.Background(), dto.ClaudeRequest{Model: "test", Messages: messages}, &convmeta.Values{})
+			require.NoError(t, err)
+			require.NotEmpty(t, got.Messages)
+			if withTool {
+				require.Len(t, got.Messages, 2)
+				require.Len(t, got.Messages[0].ParseContent(), 1)
+				require.Equal(t, "checking", got.Messages[0].ParseContent()[0].Text)
+				calls := got.Messages[0].ParseToolCalls()
+				require.Len(t, calls, 1)
+				require.Equal(t, "call_a", calls[0].ID)
+				require.Equal(t, "check", calls[0].Function.Name)
+				require.Equal(t, `{"q":"hi"}`, calls[0].Function.Arguments)
+				require.Equal(t, "tool", got.Messages[1].Role)
+				require.Equal(t, "call_a", got.Messages[1].ToolCallId)
+				require.Equal(t, "checked", got.Messages[1].Content)
+			}
+			require.Equal(t, thought, got.Messages[0].GetReasoningContent())
+		})
+	}
+}
