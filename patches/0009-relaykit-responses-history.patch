 func responsesInputItemToChatMessages(ctx context.Context, item map[string]any, messages []dto.Message) ([]dto.Message, []any, error) {
 	itemType := strings.TrimSpace(kitutil.Interface2String(item["type"]))
 	switch itemType {
+	case "reasoning":
+		for key := range item {
+			switch key {
+			case "type", "id", "status", "summary":
+			case "content":
+				if item[key] != nil {
+					return nil, nil, errors.New("reasoning.content is unsupported; only plaintext summary is supported")
+				}
+			case "role", "quality", "size":
+				if item[key] != "" {
+					return nil, nil, fmt.Errorf("reasoning.%s is unsupported", key)
+				}
+			default:
+				return nil, nil, fmt.Errorf("reasoning.%s is unsupported; only plaintext summary is supported", key)
+			}
+		}
+		summary, ok := item["summary"].([]any)
+		if !ok {
+			return nil, nil, errors.New("reasoning.summary must be an array")
+		}
+		var text strings.Builder
+		for _, raw := range summary {
+			block, ok := raw.(map[string]any)
+			if !ok || block["type"] != "summary_text" {
+				return nil, nil, errors.New("reasoning.summary must contain summary_text blocks")
+			}
+			value, ok := block["text"].(string)
+			if !ok {
+				return nil, nil, errors.New("reasoning.summary.text must be a string")
+			}
+			text.WriteString(value)
+		}
+		value := text.String()
+		return append(messages, dto.Message{Role: "assistant", ReasoningContent: &value}), nil, nil
 	case responsesInputTypeFunctionCall:
