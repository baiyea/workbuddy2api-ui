+package oairesponses
+
+import (
+	"context"
+	"testing"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/stretchr/testify/require"
+)
+
+func TestResponsesPlaintextReasoningHistory(t *testing.T) {
+	got, err := ResponsesRequestToChatCompletionsRequest(context.Background(), &dto.OpenAIResponsesRequest{
+		Model: "test", Input: []byte(`[{"role":"user","content":"hi"},{"type":"reasoning","id":"rs_1","status":"completed","content":null,"role":"","quality":"","size":"","summary":[{"type":"summary_text","text":"think "},{"type":"summary_text","text":"carefully"}]},{"type":"message","role":"assistant","content":[{"type":"output_text","text":"checking"}]},{"type":"function_call","call_id":"call_a","name":"check","arguments":"{}"},{"type":"function_call_output","call_id":"call_a","output":"checked"}]`),
+	})
+	require.NoError(t, err)
+	require.Len(t, got.Messages, 3)
+	require.Equal(t, "assistant", got.Messages[1].Role)
+	require.Equal(t, "think carefully", got.Messages[1].GetReasoningContent())
+	require.Equal(t, "checking", got.Messages[1].Content)
+	calls := got.Messages[1].ParseToolCalls()
+	require.Len(t, calls, 1)
+	require.Equal(t, "call_a", calls[0].ID)
+	require.Equal(t, "check", calls[0].Function.Name)
+	require.Equal(t, "{}", calls[0].Function.Arguments)
+	require.Equal(t, "call_a", got.Messages[2].ToolCallId)
+	require.Equal(t, "checked", got.Messages[2].Content)
+}
+
+func TestResponsesReasoningWithoutTextPreservesToolLink(t *testing.T) {
+	got, err := ResponsesRequestToChatCompletionsRequest(context.Background(), &dto.OpenAIResponsesRequest{
+		Model: "test", Input: []byte(`[{"type":"reasoning","summary":[{"type":"summary_text","text":"think"}]},{"type":"function_call","call_id":"call_a","name":"check","arguments":"{}"}]`),
+	})
+	require.NoError(t, err)
+	require.Len(t, got.Messages, 1)
+	require.Equal(t, "think", got.Messages[0].GetReasoningContent())
+	require.Equal(t, "call_a", got.Messages[0].ParseToolCalls()[0].ID)
+}
+
+func TestResponsesReasoningToolThenTextSharesAssistant(t *testing.T) {
+	got, err := ResponsesRequestToChatCompletionsRequest(context.Background(), &dto.OpenAIResponsesRequest{
+		Model: "test", Input: []byte(`[{"type":"reasoning","summary":[{"type":"summary_text","text":"think"}]},{"type":"function_call","call_id":"call_a","name":"check","arguments":"{}"},{"role":"assistant","content":"checking"}]`),
+	})
+	require.NoError(t, err)
+	require.Len(t, got.Messages, 1)
+	require.Equal(t, "think", got.Messages[0].GetReasoningContent())
+	require.Equal(t, "checking", got.Messages[0].Content)
+	require.Equal(t, "call_a", got.Messages[0].ParseToolCalls()[0].ID)
+}
