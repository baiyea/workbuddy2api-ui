new file mode 100644
index 0000000..3059f6e
--- /dev/null
+++ b/third_party/relaykit/relayconvert/internal/oai_chat/text_parts_sdk_test.go
@@ -0,0 +1,71 @@
+package oaichat
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/samber/lo"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestResponsesTextPartLifecycleForSDK(t *testing.T) {
+	for _, reasoning := range []bool{false, true} {
+		t.Run(map[bool]string{false: "text", true: "after_reasoning"}[reasoning], func(t *testing.T) {
+			state := NewChatToResponsesStreamState("resp_sdk", "model")
+			state.EmitSequenceNumber = true
+			delta := dto.ChatCompletionsStreamResponseChoiceDelta{Content: lo.ToPtr("hello")}
+			if reasoning {
+				delta.ReasoningContent = lo.ToPtr("think")
+			}
+			events := mustResponsesEventsFromChatChunk(t, state, &dto.ChatCompletionsStreamResponse{
+				Choices: []dto.ChatCompletionsStreamResponseChoice{{Delta: delta}},
+			})
+			events = append(events, mustResponsesEventsFromChatChunk(t, state, &dto.ChatCompletionsStreamResponse{
+				Choices: []dto.ChatCompletionsStreamResponseChoice{{Delta: dto.ChatCompletionsStreamResponseChoiceDelta{Content: lo.ToPtr(" world")}}},
+			})...)
+			events = append(events, FinalizeChatCompletionsStreamToResponses(state)...)
+			var textEvents []ChatToResponsesStreamEvent
+			for i, event := range events {
+				require.NotNil(t, event.Payload.SequenceNumber)
+				assert.Equal(t, i, *event.Payload.SequenceNumber)
+				if event.Payload.ContentIndex != nil {
+					textEvents = append(textEvents, event)
+				}
+			}
+			require.Len(t, textEvents, 5)
+			kinds := []string{}
+			for _, event := range textEvents {
+				kinds = append(kinds, event.Type)
+			}
+			assert.Equal(t, []string{"response.content_part.added", "response.output_text.delta", "response.output_text.delta", "response.output_text.done", "response.content_part.done"}, kinds)
+			index := 0
+			if reasoning {
+				index = 1
+			}
+			for _, event := range textEvents {
+				require.NotNil(t, event.Payload.OutputIndex)
+				assert.Equal(t, index, *event.Payload.OutputIndex)
+				assert.Equal(t, 0, *event.Payload.ContentIndex)
+				assert.Equal(t, "resp_sdk_msg_0", event.Payload.ItemID)
+			}
+			for _, pos := range []int{0, 4} {
+				raw, err := json.Marshal(textEvents[pos].Payload)
+				require.NoError(t, err)
+				var wire map[string]any
+				require.NoError(t, json.Unmarshal(raw, &wire))
+				part := wire["part"].(map[string]any)
+				assert.Equal(t, "output_text", part["type"])
+				require.NotNil(t, part["annotations"])
+				expected := ""
+				if pos == 4 {
+					expected = "hello world"
+				}
+				assert.Equal(t, expected, part["text"])
+			}
+			final := events[len(events)-1].Payload.Response
+			assert.Equal(t, "hello world", final.Output[index].Content[0].Text)
+		})
+	}
+}
